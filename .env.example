# Copy to .env and fill in before `docker compose up`.
# See backend plan doc / CLAUDE.md for context on each value.

# --- Version (lockstep across all 10 first-party services — see CLAUDE.md's
# "Versioning" section) ---
# Read from the root VERSION file by scripts/bump-version.sh into every
# package.json, and passed here so `docker compose build` tags/names images
# consistently (cirrus-<service>:${CIRRUS_VERSION}) and the 5 Go collectors'
# Dockerfiles bake it into their binary via -ldflags. Must be bumped here in
# lockstep with VERSION on every release — this line lives in the gitignored
# .env, so the bump script can't do it for you. Defaults to "dev" if unset —
# unlike the required secrets below, a missing version never blocks a build.
CIRRUS_VERSION=1.0.0

# --- Traefik routing (frontend service labels in docker-compose.yml) ---
# Only matters if you're actually running behind Traefik on the external
# `proxy` network (production) — plain local `docker compose up` never
# touches these labels at all, so these default to a harmless localhost-
# shaped value rather than failing closed like the required secrets below.
# TRAEFIK_HOSTNAME is the exact host Traefik routes to this service
# (e.g. cirrus.example.com); TRAEFIK_CERT_DOMAIN is the apex domain your
# wildcard Let's Encrypt cert covers (e.g. example.com, no subdomain
# prefix) — these are deliberately two separate values since Compose's
# own variable interpolation can't derive one from the other.
# IMPORTANT: if you're updating an existing production deployment that
# used to have these hardcoded, set both to your real domain here BEFORE
# your next `docker compose up -d --build`, or Traefik will silently stop
# routing your real public hostname.
TRAEFIK_HOSTNAME=cirrus.localhost
TRAEFIK_CERT_DOMAIN=localhost

# --- Postgres ---
# Required — no default. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Postgres backup (postgres-backup service, backup/postgres-entrypoint.sh) ---
# How often it runs a fresh gzipped pg_dump, and how many days of backups
# it keeps in ./backups/postgres/ before pruning. Defaults: daily, 1 week.
PG_BACKUP_INTERVAL_SECONDS=86400
PG_BACKUP_RETENTION_DAYS=7

# --- Shared internal secret (must match across all services; Compose injects
# the same value into each) ---
# Required — no default. Generate with: openssl rand -hex 32
INTERNAL_SHARED_SECRET=

# --- Logging (bff/auth/rbac/aggregator) ---
# Pino log level. Lower it to "debug" for local troubleshooting, raise it to
# "warn" to quiet a noisy production environment. Default matches Pino's own
# default, so leaving this unset changes nothing.
LOG_LEVEL=info

# --- Vault (production mode — file storage backend, persists across
# restarts via the vault-file Docker volume) ---
# RBAC is the only service with a Vault token; it stores/retrieves
# per-connection secrets for providers that need them (AWS, OCI, Biznet Gio).
# Required — no default. Generate with: openssl rand -hex 32, and pick it
# BEFORE first `docker compose up` — vault/entrypoint.sh's bootstrap script
# creates a Vault token with exactly this value on first init, scoped to a
# least-privilege policy covering only cirrus/connections/* secrets (never
# the root token).
# The Shamir unseal keys + initial root token are generated once on first
# boot and written to the vault-init Docker volume (not printed to
# `docker compose logs vault`, and not the same volume as Vault's own
# encrypted data) — retrieve them from there right away and save them
# somewhere safe (e.g. a password manager); they're Vault's only recovery
# path if the vault-file volume's bootstrap record is ever lost or corrupted.
VAULT_TOKEN=

# --- Vault backup (vault-backup service, backup/vault-entrypoint.sh) ---
# How often it tars vault-file (read-only), and how many days of backups it
# keeps in ./backups/vault/ before pruning. Defaults: daily, 1 week. Does
# NOT back up vault-init (the unseal keys/root token) — see that script's
# comments for why.
VAULT_BACKUP_INTERVAL_SECONDS=86400
VAULT_BACKUP_RETENTION_DAYS=7

# --- RBAC seed ---
# Email of the first Admin — must match exactly the account that will first
# log in via Entra ID, so RBAC's upsert-on-login can activate this row.
SEED_ADMIN_EMAIL=admin@example.com
# Optional — defaults to "Administrator" if unset.
SEED_ADMIN_NAME=

# --- RBAC connection health-check scheduler (PRD §6.1) ---
# How often (seconds) RBAC automatically re-runs the same check as "Test
# Connection" against every stored connection. Default is 6 hours. Lower
# for local dev (e.g. 60) to see it run without waiting; 0 disables it.
HEALTH_CHECK_INTERVAL_SECONDS=21600

# --- Outage alerting (Telegram, backend/rbac/src/lib/telegramAlert.ts) ---
# Optional — both unset means alerting silently no-ops (the scheduler still
# runs and updates connection status either way). Fires only on a scheduled
# health-check pass flipping a connection's status (error <-> active), never
# on a manual Test Connection click.
# Bot token: message @BotFather on Telegram, /newbot, follow the prompts.
# Chat id: add the bot to the target chat/group, send it any message, then
# GET https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/getUpdates and read
# the numeric "chat":{"id": ...} field back.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Invite emails (Resend, backend/rbac/src/lib/resendClient.ts) ---
# Optional — unset means invite emails silently no-op (the user row is still
# created as 'pending'; POST /users still succeeds). Get an API key from
# https://resend.com/api-keys.
# RESEND_FROM_EMAIL's domain MUST be verified in Resend's dashboard (DNS
# records) before sends succeed — sending from an unverified domain fails
# with a 403. Defaults to the production domain below; override only once a
# different domain is verified in your Resend account.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Cirrus <notification@example.com>
# Public URL of the frontend SPA — used only to build the "Sign in to
# Cirrus" button in invite emails. Defaults to local dev; production sets
# this to your real public URL (e.g. https://cirrus.example.com — same
# value as CORS_ORIGIN/AUTH_REDIRECT_URI's frontend host below).
APP_URL=http://localhost:5173

# --- Entra ID (Microsoft Entra ID / Azure AD) app registration ---
# REQUIRED before the login flow works end-to-end. Create a single-tenant app
# registration in the Azure Portal with:
#   - Redirect URI (Web): http://localhost:8080/auth/callback (dev)
#   - API permissions: Microsoft Graph delegated `openid` + `profile`
#   - A client secret (or certificate)
# Running behind the Traefik reverse proxy (see docker-compose.yml's
# `frontend` service labels)? Use these instead — the browser only ever
# talks to `frontend`'s nginx, which reverse-proxies /auth/* to bff, so the
# redirect URI must point at frontend's public hostname, not bff's:
#   AUTH_REDIRECT_URI=https://cirrus.example.com/auth/callback
#   POST_LOGIN_REDIRECT=https://cirrus.example.com/
#   CORS_ORIGIN=https://cirrus.example.com
# (also update the Redirect URI in the Entra ID app registration itself —
# Azure rejects any redirect URI not registered exactly)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
AUTH_REDIRECT_URI=http://localhost:8080/auth/callback
POST_LOGIN_REDIRECT=http://localhost:5173/
# bff's allowed CORS origin — must exactly match the frontend's public URL
# (scheme+host+port, no trailing slash). Only requests from this origin can
# read bff's responses with credentials (the session cookie) attached.
CORS_ORIGIN=http://localhost:5173

# --- Rate limiting ---
# auth's /login and /dev-login share one budget (both are low-frequency,
# rare-per-user routes). bff's general /api/* gets a separate, higher budget.
# Cirrus is an internal tool, not multi-tenant SaaS — real users likely share
# one corporate egress IP/VPN, so these defaults are picked generous enough
# to not lock out a shared-IP office during normal use while still
# throttling scripted abuse. Tune per deployment; no code change needed.
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_API_MAX=300
RATE_LIMIT_API_WINDOW_SECONDS=60

# --- Auth Service session/signing ---
JWT_ISSUER=https://auth.cirrus.internal
JWT_AUDIENCE=cirrus-bff
SESSION_COOKIE_NAME=cirrus_session
# Behind Traefik (HTTPS), set this to true — otherwise the session cookie
# won't be sent back over TLS and login will silently break.
COOKIE_SECURE=false
# Required — no default. Generate with: openssl rand -hex 32
COOKIE_SECRET=
SESSION_TTL_SECONDS=43200
# Optional: a pinned ES256 JWK (JSON) so sessions survive an auth container
# restart. Leave blank in dev — an ephemeral key is generated at boot.
# MUST be pinned once any real GCP connection exists (Workload Identity
# Federation) — a key rotation would silently break WIF until someone
# re-uploads the new JWKS on GCP's side.
AUTH_SIGNING_KEY_JWK=

# TEMPORARY, dev-only: set to true to enable GET /auth/dev-login?email=...,
# a bypass that logs in as any already-invited RBAC user without a real
# Entra ID redirect. Must stay false/unset outside local dev — never enable
# in a real deployment. Remove this flag entirely once Entra ID is wired up.
# Also gated on NODE_ENV as a second layer of defense: deploying with
# `docker compose -f docker-compose.yml -f docker-compose.prod.yml up` sets
# NODE_ENV=production, which suppresses this bypass even if it's left `true`
# here by mistake.
DEV_LOGIN_ENABLED=false

# AWS and Alibaba Cloud both use per-connection static credentials (Access
# Key ID/Secret, entered per registered account in the Add Connection
# wizard, the secret stored in Vault) — no hub credential env vars needed
# here at all.

# --- GCP Collector ---
# No static secret needed at all — Workload Identity Federation per
# PRD §7.3. Requires real GCP resources (project, Workload Identity Pool +
# Provider with a local JWK upload since this environment has no public
# domain, service account) that don't exist yet; see CLAUDE.md.
