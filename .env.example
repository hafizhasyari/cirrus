# Copy to .env and fill in before `docker compose up`.
# See backend plan doc / CLAUDE.md for context on each value.

# --- Postgres ---
POSTGRES_PASSWORD=cirrus_dev

# --- Shared internal secret (any random string; must match across all services) ---
INTERNAL_SHARED_SECRET=dev-internal-secret

# --- Vault (dev mode — in-memory, auto-unsealed, data does NOT survive a
# restart; same tier of guarantee as this file's other dev-* defaults) ---
# RBAC is the only service with a Vault token; it stores/retrieves
# per-connection secrets for providers that need them (OCI, Biznet Gio).
VAULT_DEV_ROOT_TOKEN_ID=dev-vault-root-token

# --- RBAC seed ---
# Email of the first Admin — must match exactly the account that will first
# log in via Entra ID, so RBAC's upsert-on-login can activate this row.
SEED_ADMIN_EMAIL=admin@example.com
# Optional — defaults to "Administrator" if unset.
SEED_ADMIN_NAME=

# --- Entra ID (Microsoft Entra ID / Azure AD) app registration ---
# REQUIRED before the login flow works end-to-end. Create a single-tenant app
# registration in the Azure Portal with:
#   - Redirect URI (Web): http://localhost:8080/auth/callback (dev)
#   - API permissions: Microsoft Graph delegated `openid` + `profile`
#   - A client secret (or certificate)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
AUTH_REDIRECT_URI=http://localhost:8080/auth/callback
POST_LOGIN_REDIRECT=http://localhost:5173/

# --- Auth Service session/signing ---
JWT_ISSUER=https://auth.cirrus.internal
JWT_AUDIENCE=cirrus-bff
SESSION_COOKIE_NAME=cirrus_session
COOKIE_SECURE=false
COOKIE_SECRET=dev-cookie-secret-change-me
SESSION_TTL_SECONDS=43200
# Optional: a pinned ES256 JWK (JSON) so sessions survive an auth container
# restart. Leave blank in dev — an ephemeral key is generated at boot.
# MUST be pinned once any real GCP connection exists (Workload Identity
# Federation) — a key rotation would silently break WIF until someone
# re-uploads the new JWKS on GCP's side.
AUTH_SIGNING_KEY_JWK=

# TEMPORARY, dev-only: set to true to enable GET /auth/dev-login?email=...,
# a bypass that logs in as any already-invited RBAC user without a real
# Entra ID redirect. Must stay false/unset outside local dev — never enable
# in a real deployment. Remove this flag entirely once Entra ID is wired up.
DEV_LOGIN_ENABLED=false

# AWS uses per-connection static IAM user credentials (Access Key ID /
# Secret Access Key, entered per registered account in the Add Connection
# wizard, Secret Access Key stored in Vault) — no hub credential env vars
# needed here at all.

# --- Alibaba Cloud Collector hub credential (same idea, RAM AssumeRole) ---
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# --- GCP Collector ---
# No static secret needed at all — Workload Identity Federation per
# PRD §7.3. Requires real GCP resources (project, Workload Identity Pool +
# Provider with a local JWK upload since this environment has no public
# domain, service account) that don't exist yet; see CLAUDE.md.
